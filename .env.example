# 複製成 .env 後填入實際值：cp .env.example .env
# 變數清單依 docs/IMPLEMENTATION.md §10

# 對應 docker-compose.yml 的 postgres 服務（帳號/密碼/庫名皆為 dochuki）
DATABASE_URL=postgresql://dochuki:dochuki@localhost:5432/dochuki

# 收據解析用（Phase 2 才會實際呼叫）。切勿寫進版控。
ANTHROPIC_API_KEY=

# 收據原圖儲存位置。IMPLEMENTATION.md §10 記載的容器/正式環境值為 /data/receipts；
# 本機開發（尤其 Windows）用專案內相對路徑，此目錄已列入 .gitignore。
RECEIPT_STORAGE_DIR=./data/receipts

# 匯率來源（Phase 2 才會實際呼叫）
FX_API_BASE=https://api.frankfurter.dev
