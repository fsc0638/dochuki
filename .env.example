# 複製成 .env 後填入實際值：cp .env.example .env
# 變數清單依 docs/IMPLEMENTATION.md §10

# 對應 docker-compose.yml 的 postgres 服務（帳號/密碼/庫名皆為 dochuki）。
# 連接埠為 5442 而非 IMPLEMENTATION.md §10 記載的 5432——本機 5432 已被既有的
# PostgreSQL 18 Windows 服務占用，故容器對外改映射 5442。
DATABASE_URL=postgresql://dochuki:dochuki@localhost:5442/dochuki

# 收據解析用（P3 才會實際呼叫，2026-08-25 起改用 Gemini）。切勿寫進版控。
GEMINI_API_KEY=

# 收據原圖儲存位置。IMPLEMENTATION.md §10 記載的容器/正式環境值為 /data/receipts；
# 本機開發（尤其 Windows）用專案內相對路徑，此目錄已列入 .gitignore。
RECEIPT_STORAGE_DIR=./data/receipts

# 匯率來源（P2 才會實際呼叫）
FX_API_BASE=https://api.frankfurter.dev

# P5「docker compose up -d --build」容器化部署時，app 服務對外映射的
# host port。預設 3000；本機這台開發機的 3000 是 Windows 保留的排除
# port range 綁不了，改用 3010——別的環境通常不需要這行，留空或整行刪掉
# 即可套用 docker-compose.yml 的預設值 3000。
APP_PORT=3000
