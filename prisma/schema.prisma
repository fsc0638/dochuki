// 道中記 Dōchūki 資料模型
// 依 docs/IMPLEMENTATION.md §4 實作。
//
// 與 §4 記載的差異（Prisma 7 強制）：
//   §4 寫 `provider = "prisma-client-js"`，但 Prisma 7 已棄用該 generator，
//   實際可用者為 `prisma-client` 且 `output` 為必填。
//   datasource 的 url 亦改由 prisma.config.ts 提供。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SplitMode {
  EQUAL
  WEIGHT
  EXACT
  BY_GROUP
}

enum FundType {
  CONTRIBUTION
  SPEND
}

enum RateSource {
  TRIP_FIXED
  DAILY_REF
  MANUAL
}

enum ParseEngine {
  LLM_VISION
  PADDLE_OCR
  MANUAL
}

/// 一個 User 在一個 Trip 裡的角色（P7.1）。
/// OWNER 是建立者：可改行程設定、發邀請券、刪行程。
/// EDITOR 是一般團員：可記帳、改支出，但不能邀請別人（2026-09-07 使用者裁示）。
/// VIEWER 只能看。
enum TripRole {
  OWNER
  EDITOR
  VIEWER
}

model Trip {
  id           String    @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  homeCurrency String    @default("TWD")
  fixedRates   Json? // {"JPY": "0.25"} 幣別→記帳幣固定匯率
  members      Member[]
  groups       Group[]
  expenses     Expense[]
  funds        Fund[]
  receipts     Receipt[]
  memberships  TripMembership[]
  invites      Invite[]
  createdAt    DateTime  @default(now())
}

model Group {
  id      String   @id @default(cuid())
  tripId  String
  trip    Trip     @relation(fields: [tripId], references: [id])
  name    String // 銀髮組 / 夫妻組 / 兄弟組…
  members Member[]
}

model Member {
  id          String         @id @default(cuid())
  tripId      String
  trip        Trip           @relation(fields: [tripId], references: [id])
  groupId     String?
  group       Group?         @relation(fields: [groupId], references: [id])
  name        String
  shares      ExpenseShare[]
  paid        Expense[]      @relation("payer")
  fundEntries FundEntry[]
  // 這位團員綁到哪個登入帳號（P7.1）。null 代表還沒有人認領這個身分——
  // 名字先由團長建好、之後才發邀請券是常態，所以是選填的一對一。
  membership  TripMembership?
  invites     Invite[]
}

model Expense {
  id             String         @id @default(cuid())
  tripId         String
  trip           Trip           @relation(fields: [tripId], references: [id])
  payerId        String?
  payer          Member?        @relation("payer", fields: [payerId], references: [id])
  paidAt         DateTime
  category       String
  description    String
  currency       String // ISO 4217
  amountOriginal Decimal        @db.Decimal(18, 6)
  rateSource     RateSource
  rateUsed       Decimal        @db.Decimal(18, 8) // 1 原幣 = rateUsed 記帳幣（快照）
  amountHome     Decimal        @db.Decimal(18, 6) // = amountOriginal × rateUsed
  splitMode      SplitMode
  fundSpend      Boolean        @default(false) // true = 由公費支付，不進個人分攤
  shares         ExpenseShare[]
  lineItems      LineItem[]
  receipts       Receipt[]
  createdAt      DateTime       @default(now())

  @@index([tripId, paidAt])
}

model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id])
  shareHome Decimal @db.Decimal(18, 6) // 記帳幣分攤額（引擎輸出落地）

  @@id([expenseId, memberId])
}

model LineItem {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  nameRaw   String // 原文（如日文）
  nameZh    String? // 譯文
  qty       Decimal  @db.Decimal(12, 4)
  unitPrice Decimal  @db.Decimal(18, 6)
  amount    Decimal  @db.Decimal(18, 6)
  taxRate   Decimal? @db.Decimal(6, 4) // 0.08 / 0.10
  category  String?
}

model Receipt {
  id String @id @default(cuid())
  // 收據一上傳就屬於某個行程（api/parse/route.ts 本來就收得到 tripId）。
  // P7.0 之前沒有這個欄位，尚未建立支出的收據與任何行程都沒有關聯，
  // 導致「這張收據屬不屬於我的行程」這個問題在資料層問不出來——不是查詢
  // 寫錯，是資料模型缺一塊。expenseId 仍可為 null（上傳後、確認入帳前）。
  tripId     String
  trip       Trip        @relation(fields: [tripId], references: [id])
  expenseId  String?
  expense    Expense?    @relation(fields: [expenseId], references: [id])
  imagePath  String // /data/receipts/... 原圖永久保存
  engine     ParseEngine
  parseJson  Json? // 解析輸出（§5 schema）
  confidence Json? // 逐欄信心
  parsedAt   DateTime?
  createdAt  DateTime    @default(now())

  @@index([tripId])
}

model Fund {
  id       String      @id @default(cuid())
  tripId   String
  trip     Trip        @relation(fields: [tripId], references: [id])
  name     String      @default("公費")
  currency String      @default("JPY")
  entries  FundEntry[]
}

model FundEntry {
  id              String   @id @default(cuid())
  fundId          String
  fund            Fund     @relation(fields: [fundId], references: [id])
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id])
  type            FundType
  amount          Decimal  @db.Decimal(18, 6) // 公費幣別
  linkedExpenseId String?
  note            String?
  occurredAt      DateTime @default(now())
}

model FxRate {
  date   DateTime
  base   String
  quote  String
  rate   Decimal  @db.Decimal(18, 8)
  source String // frankfurter / manual

  @@id([date, base, quote])
}

// ============================================================== 帳號系統 ====
// P7.1。設計說明見 docs/AUTH_PLAN.md。
//
// 核心決定：登入身分（User）與分攤身分（Member）分開，用 TripMembership 綁。
// Member 維持原樣不動，分攤引擎繼續以 memberId 為準，src/lib/money/ 一行不用改。

model User {
  id String @id @default(cuid())
  // 密碼帳號才有 email；邀請進來的帳號兩個都是 null（2026-09-07 裁示：
  // 密碼帳號用 email 當識別欄位）。可空欄位加 @unique 在 PostgreSQL 是
  // 允許多筆 NULL 的，所以不會互相打架。
  email        String? @unique
  passwordHash String?
  displayName  String

  // 登入失敗節流（P7.2）。連續失敗會鎖一小段時間，時間隨次數遞增但有上限。
  // 成功登入就歸零。
  //
  // 取捨：鎖帳號會讓人可以拿別人的 email 亂猜來癱瘓那個帳號，所以鎖定時間
  // 上限壓在 15 分鐘、不做永久鎖定——擋住的是自動化撞庫，而不是「讓攻擊者
  // 有辦法把人鎖在門外」。
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions       Session[]
  memberships    TripMembership[]
  invitesCreated Invite[]         @relation("inviteCreator")
  createdAt      DateTime         @default(now())
}

model Session {
  id String @id @default(cuid())
  // 只存 token 的 SHA-256，不存原值——資料庫外洩不等於 session 被冒用。
  // 原始 token 只在簽發當下回傳一次，之後任何地方都拿不回來。
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  // 清理過期 session 的批次會掃這個欄位
  @@index([expiresAt])
}

model TripMembership {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 這個帳號在該行程對應到哪個團員。一個 Member 最多被一個帳號認領，
  // 所以是 @unique；null 代表這個帳號有權限但不參與分攤（例如純記帳的人）。
  memberId String?  @unique
  member   Member?  @relation(fields: [memberId], references: [id])
  role     TripRole @default(EDITOR)
  joinedAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
}

model Invite {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // 具名邀請（2026-09-07 裁示）：這張券就是給這位團員的，認領時直接綁定，
  // 不讓被邀請者自己挑要當誰。
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  // 券只能發 EDITOR 或 VIEWER——被邀請者不能再邀請別人（2026-09-07 裁示），
  // 而發券是 OWNER 才有的權限。這條由 P7.3 的建立函式與 zod 強制，
  // enum 本身無法只允許部分值。
  role TripRole @default(EDITOR)

  // 同樣只存雜湊。可重複使用，但有三道閘門：到期日、可用次數、隨時可撤銷。
  tokenHash String    @unique
  expiresAt DateTime
  maxUses   Int       @default(5)
  usedCount Int       @default(0)
  revokedAt DateTime?

  createdBy String
  creator   User     @relation("inviteCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  @@index([tripId])
}
